            "uid": "${ds}"
          },
          "queryType": "Azure Resource Graph",
          "subscriptions": [
            "$sub"
          ],
          "azureResourceGraph": {
            "query": "alertsmanagementresources\n| where type =~ 'microsoft.alertsmanagement/alerts'\n| where tostring(properties.essentials.monitorCondition) == 'Fired'\n| where tostring(properties.essentials.targetResourceGroup) startswith 'beez360-'\n| summarize Fired = count()",
            "resultFormat": "table"
          }
        }
