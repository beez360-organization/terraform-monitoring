    {
      "type": "stat",
      "title": "Plateformes",
      "description": "",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-azure-monitor-datasource",
            "uid": "${ds}"
          },
          "queryType": "Azure Resource Graph",
          "subscriptions": [
            "$sub"
          ],
          "azureResourceGraph": {
            "query": "resourcecontainers\n| where type == 'microsoft.resources/subscriptions/resourcegroups' and name startswith 'beez360-' and name endswith '-rg'\n| where name !contains 'tfstate' and name !contains 'observability'\n| summarize Platforms = count()",
            "resultFormat": "table"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
