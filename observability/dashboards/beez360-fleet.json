            "uid": "${ds}"
          },
          "queryType": "Azure Resource Graph",
          "subscriptions": [
            "$sub"
          ],
          "azureResourceGraph": {
            "query": "resources | where type =~ 'microsoft.web/sites' and resourceGroup startswith 'beez360-'\n| where tostring(properties.state) != 'Running' | summarize Stopped = count()",
