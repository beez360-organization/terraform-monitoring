    {
      "type": "table",
      "title": "Inventaire des plateformes",
      "description": "",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-azure-monitor-datasource",
            "uid": "${ds}"
          },
          "queryType": "Azure Resource Graph",
          "subscriptions": [
            "$sub"
          ],
          "azureResourceGraph": {
            "query": "resourcecontainers\n| where type == 'microsoft.resources/subscriptions/resourcegroups' and name startswith 'beez360-' and name endswith '-rg'\n| project Platform = name, Type = tostring(tags.PlatformType), Tier = tostring(tags.Tier),\n          Environment = tostring(tags.Environment), Country = tostring(tags.Country),\n          CostCenter = tostring(tags.CostCenter), Region = location, subscriptionId\n| order by Type asc, Platform asc",
            "resultFormat": "table"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
