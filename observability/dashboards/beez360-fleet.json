    {
      "type": "table",
      "title": "Exposition réseau des services de données",
      "description": "« Enabled » sans private endpoint sur une plateforme prod = à corriger.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-azure-monitor-datasource",
            "uid": "${ds}"
          },
          "queryType": "Azure Resource Graph",
          "subscriptions": [
            "$sub"
          ],
          "azureResourceGraph": {
            "query": "resources\n| where resourceGroup startswith 'beez360-'\n| where type in~ ('microsoft.keyvault/vaults', 'microsoft.storage/storageaccounts',\n                  'microsoft.containerregistry/registries', 'microsoft.dbforpostgresql/flexibleservers',\n                  'microsoft.cache/redis')\n| extend PublicAccess = coalesce(tostring(properties.publicNetworkAccess), tostring(properties.network.publicNetworkAccess))\n| extend PrivateEndpoints = array_length(properties.privateEndpointConnections)\n| project Platform = resourceGroup, Service = tostring(split(type, '/')[1]), Name = name, PublicAccess, PrivateEndpoints\n| order by Platform asc, Service asc",
            "resultFormat": "table"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "filterable": true,
            "cellOptions": {
              "type": "auto"
            }
