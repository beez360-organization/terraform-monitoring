{
  "uid": "beez360-api-performance",
  "title": "Beez360 · Performance applicative",
  "description": "Requêtes, latence, exceptions et dépendances (Application Insights via Log Analytics, requêtes à l'échelle du resource group de la plateforme).",
  "tags": [
    "beez360"
  ],
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "5m",
  "timezone": "browser",
  "templating": {
    "list": [
      {
        "name": "ds",
        "label": "Data source",
        "type": "datasource",
        "query": "grafana-azure-monitor-datasource",
        "hide": 0,
        "refresh": 1,
        "current": {},
        "options": []
      },
      {
        "name": "sub",
        "label": "Subscription",
        "type": "query",
        "datasource": {
          "type": "grafana-azure-monitor-datasource",
          "uid": "${ds}"
        },
        "query": {
          "queryType": "Azure Subscriptions",
          "refId": "A"
        },
        "refresh": 1,
        "hide": 0,
        "multi": false,
        "includeAll": false,
        "current": {},
        "options": [],
        "sort": 1
      },
      {
        "name": "platform",
        "label": "Platform",
        "type": "query",
        "datasource": {
          "type": "grafana-azure-monitor-datasource",
          "uid": "${ds}"
        },
        "query": {
          "queryType": "Azure Resource Groups",
          "subscription": "$sub",
          "refId": "A"
        },
        "regex": "/^(beez360-[a-z0-9-]+-rg)$/",
        "refresh": 1,
        "hide": 0,
        "sort": 1,
        "current": {},
        "options": []
      }
    ]
  },
  "links": [
    {
      "title": "Beez360",
      "type": "dashboards",
      "tags": [
        "beez360"
      ],
      "asDropdown": true,
      "includeVars": true,
      "keepTime": true
    }
  ],
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Indicateurs clés (Application Insights)",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Requêtes",
      "description": "",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-azure-monitor-datasource",
            "uid": "${ds}"
          },
          "queryType": "Azure Log Analytics",
          "azureLogAnalytics": {
            "query": "AppRequests | where $__timeFilter(TimeGenerated) | summarize Requests = count()",
            "resources": [
              "/subscriptions/$sub/resourceGroups/$platform"
            ],
            "resultFormat": "table",
            "dashboardTime": false
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto"
      },
      "id": 2,
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "grafana-azure-monitor-datasource",
        "uid": "${ds}"
      }
    },
    {
      "type": "stat",
      "title": "Taux d'échec",
      "description": "",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-azure-monitor-datasource",
            "uid": "${ds}"
          },
          "queryType": "Azure Log Analytics",
          "azureLogAnalytics": {
            "query": "AppRequests | where $__timeFilter(TimeGenerated)\n| summarize FailureRate = 100.0 * countif(Success == false) / count()",
            "resources": [
              "/subscriptions/$sub/resourceGroups/$platform"
            ],
            "resultFormat": "table",
            "dashboardTime": false
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              },
              {
                "value": 1,
                "color": "orange"
              },
              {
                "value": 5,
                "color": "red"
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto"
      },
      "id": 3,
      "gridPos": {
        "x": 6,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "grafana-azure-monitor-datasource",
        "uid": "${ds}"
      }
    },
