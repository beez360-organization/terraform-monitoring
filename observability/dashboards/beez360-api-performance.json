            "type": "grafana-azure-monitor-datasource",
            "uid": "${ds}"
          },
          "queryType": "Azure Log Analytics",
          "azureLogAnalytics": {
            "query": "AppRequests | where $__timeFilter(TimeGenerated)\n| summarize Requests = count(), P95_ms = round(percentile(DurationMs, 95), 0), Failures = countif(Success == false)\n    by Operation = OperationName, Application = AppRoleName\n| top 15 by P95_ms desc",
            "resources": [
              "/subscriptions/$sub/resourceGroups/$platform"
            ],
            "resultFormat": "table",
            "dashboardTime": false
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "filterable": true,
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
