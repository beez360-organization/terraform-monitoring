          "azureLogAnalytics": {
            "query": "AppRequests | where $__timeFilter(TimeGenerated) and Success == false\n| summarize Failures = count(), LastSeen = max(TimeGenerated) by Operation = OperationName, ResultCode, Application = AppRoleName\n| top 15 by Failures desc",
            "resources": [
              "/subscriptions/$sub/resourceGroups/$platform"
            ],
            "resultFormat": "table",
            "dashboardTime": false
          }
        }
      ],
      "fieldConfig": {
